<!-- Google tag (gtag.js). Imported into the <head> of every classic layout.
     Measurement id comes from TDM config display.googleAnalyticsMeasurementId. -->
<jsp:root version="2.0" xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:s="/struts-tags">
<s:if test="%{googleAnalyticsMeasurementId != null}">
	<s:set var="gaMeasurementId" value="googleAnalyticsMeasurementId" />
	<script async="async" src="https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}"><!-- //prevent jspx minimization --></script>
	<script type="text/javascript">
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', '${gaMeasurementId}', { site_version: 'classic' });
	</script>
	<!-- custom UI events (OBA.Config.analyticsEvent) only fire when TDM display.googleAnalyticsEventsEnabled is true -->
	<s:if test="%{googleAnalyticsEventsEnabled}">
	<script type="text/javascript">
		window.obaGoogleAnalyticsEventsEnabled = true;
	</script>
	</s:if>
</s:if>
</jsp:root>
